{
  "manifest_version": 3,
  "name": "betterr",
  "version": "1.0",
  "description": "Elevate your writing in Gmail and LinkedIn.",
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "*://*.linkedin.com/*",
    "*://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "linkedin_content.js"
      ],
      "css": [
        "content.css",
        "linkedin_content.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "betterr",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  }
}
